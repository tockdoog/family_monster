# backend/.env.example
# Plantilla de variables de entorno. Copie este archivo como ".env" (NO lo versione).
# En Vercel, estas variables se configuran en Project Settings > Environment Variables.
# Nunca escriba secretos reales en este archivo: es solo una plantilla pública.

# Entorno de ejecución: desarrollo | pruebas | produccion
# En Vercel debe ser "produccion" (activa las validaciones de seguridad estrictas).
ENTORNO=desarrollo

# URL de PostgreSQL que usa la aplicación.
# En Neon: use la cadena de conexión con "Connection pooling" activado (el host contiene "-pooler").
DATABASE_URL=postgresql://usuario:clave@localhost:5432/familia_monster

# URL directa (SIN pooler) usada solo por Alembic para migrar. En Neon: la cadena con pooling desactivado.
# Se usa desde su computador al ejecutar migraciones; no es necesaria en Vercel.
DATABASE_URL_MIGRACIONES=

# Secreto para firmar tokens (mínimo 32 caracteres). Genere uno con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Duración del token de acceso en minutos (entre 1 y 120).
MINUTOS_EXPIRACION_ACCESO=15

# Token para crear el primer hogar y administrador (POST /api/v1/instalacion). Mínimo 24 caracteres.
# Déjelo vacío (o bórrelo) cuando termine la instalación: el endpoint queda deshabilitado.
# Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SETUP_TOKEN=

# Orígenes permitidos por CORS y por la defensa CSRF, separados por coma (sin "*").
# En producción: solo URLs https:// exactas del frontend, por ejemplo https://nombre-proyecto.vercel.app
CORS_ORIGENES=http://localhost:5173

# Cookie de sesión: en producción debe ser true (HTTPS). En local sin HTTPS use false.
COOKIE_SECURE=false

# SameSite de la cookie: lax | strict | none. Se recomienda "lax" (el frontend reenvía /api al backend).
COOKIE_SAMESITE=lax

# En Vercel (serverless) debe ser true para no agotar las conexiones a PostgreSQL.
USAR_NULLPOOL=true

# Muestra la documentación interactiva (/api/docs) también en producción. Déjela en false;
# actívela solo de forma temporal si la necesita y vuelva a apagarla.
DOCS_HABILITADAS=false