# frontend/.env.example
# Copiar como frontend/.env.local. Solo variables públicas: nunca poner secretos aquí.

# Ruta base de la API. Relativa a propósito: en local la atiende el proxy de Vite
# y en Vercel la atiende el rewrite de vercel.json, así la cookie HttpOnly viaja sin CORS.
VITE_API_URL=/api/v1
